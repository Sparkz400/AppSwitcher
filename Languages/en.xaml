    <sys:String x:Key="Setup_Intro">Review these steps before using AppSwitcher at your workstation. Configured means settings are present; test them on this computer. You can return to this checklist at any time.</sys:String>
    <sys:String x:Key="Setup_Configured">Settings present — review and test</sys:String>
    <sys:String x:Key="Setup_Review">Needs review</sys:String>
    <sys:String x:Key="Setup_Optional">Optional for your workstation</sys:String>
