    <!-- Settings: Kiosk -->
    <sys:String x:Key="Settings_KioskMode">Kiosk Mode (Admin)</sys:String>
    <sys:String x:Key="Settings_KioskEnable">Enable Kiosk Mode</sys:String>
    <sys:String x:Key="Settings_KioskDescription">Blocks common shell shortcuts (Alt+Tab, Win, Alt+F4, Ctrl+Esc, Ctrl+Shift+Esc), hides the Windows taskbar on all monitors, reclaims focus from Windows shell surfaces such as Start and task view, and on supported Windows editions attempts Keyboard Filter lockdown for Ctrl+Alt+Del, Ctrl+Shift+Esc, and Win+L.</sys:String>
    <sys:String x:Key="Settings_KioskWarning">Note: Machine-level secure-key lockdown requires an elevated helper, is only supported on Enterprise, Education, and IoT Enterprise editions, and may require a reboot the first time Keyboard Filter is enabled.</sys:String>
    <sys:String x:Key="Settings_KioskDiagnostics">Kiosk Diagnostics</sys:String>
    <sys:String x:Key="Settings_KioskDiagnosticsDescription">Current protection status</sys:String>
    <sys:String x:Key="Settings_KioskDeploymentNotes">AppSwitcher applies app-level kiosk hardening immediately and attempts Windows Keyboard Filter lockdown on supported editions through an elevated helper. The first Keyboard Filter enablement can require a reboot.</sys:String>

