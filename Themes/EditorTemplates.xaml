                    <TextBlock Grid.Column="1" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="10,0,0,0" />
                </Grid>
            </Border>
            <Popup IsOpen="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" StaysOpen="False" Placement="Bottom">
                <Border Background="{DynamicResource PopupBg}" BorderBrush="{DynamicResource PopupBorder}" BorderThickness="1" CornerRadius="4" Padding="10">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.18" />
                    </Border.Effect>
                    <ItemsControl ItemsSource="{Binding PresetColors}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="44" Height="44" Margin="2" Background="{Binding}" Cursor="Hand" Command="{Binding DataContext.SetFgColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding}" ToolTip="{Binding}" FocusVisualStyle="{StaticResource FocusRing}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="4" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" />
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </Popup>
        </Grid>
    </ControlTemplate>
    <ControlTemplate x:Key="ColorPickerBorderTemplate" TargetType="ToggleButton">
        <Grid>
            <Border Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="4" Padding="6" Cursor="Hand">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30" />
