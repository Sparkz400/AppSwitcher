<Window x:Class="AppSwitcher.BrowserSetupWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="{Binding Title}" Style="{StaticResource AppWindowStyle}" Width="650" Height="640" MinWidth="540" MinHeight="460" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
 <DockPanel Margin="24">
  <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
   <Button Content="{DynamicResource UI_Close}" Click="Close_Click" IsCancel="True" Margin="0,0,8,0"/>
   <Button Content="{DynamicResource Setup_Done}" Command="{Binding FinishCommand}" Style="{StaticResource PrimaryButton}" IsDefault="True" Visibility="{Binding ShowFinish, Converter={StaticResource BoolToVis}}"/>
  </StackPanel>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
   <StackPanel Margin="0,0,12,0">
    <TextBlock Text="{Binding Status}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
    <TextBlock Text="{Binding Error}" Foreground="{DynamicResource WarningFg}" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="{Binding Error, Converter={StaticResource StringNotEmptyToVis}}" AutomationProperties.LiveSetting="Polite"/>
    <Button Content="{DynamicResource Setup_Retry}" Command="{Binding PrepareCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="{Binding NeedsPrepare, Converter={StaticResource BoolToVis}}"/>
    <StackPanel Visibility="{Binding HostReady, Converter={StaticResource BoolToVis}}">
     <TextBlock Text="{DynamicResource Setup_HostReady}" Foreground="{DynamicResource TextSecondary}" Margin="0,8,0,16" TextWrapping="Wrap" Visibility="{Binding ShowHostReady, Converter={StaticResource BoolToVis}}"/>
     <TextBlock Text="{Binding SelectedProfile.DisplayName}" Visibility="{Binding ShowSingleProfile, Converter={StaticResource BoolToVis}}" TextWrapping="Wrap" Margin="0,0,0,12"/>
     <StackPanel Visibility="{Binding PackageBlocked, Converter={StaticResource BoolToVis}}" Margin="0,12,0,0">
      <TextBlock Text="{DynamicResource Setup_FirefoxUnavailable}" TextWrapping="Wrap"/>
      <Expander Header="{DynamicResource Setup_AlreadyInstalled}" Margin="0,14,0,0"><StackPanel Margin="0,8,0,0"><TextBlock Text="{DynamicResource Setup_ExistingFirefox}" TextWrapping="Wrap"/><Button Content="{DynamicResource Setup_Check}" Command="{Binding RefreshConnectionCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/></StackPanel></Expander>
     </StackPanel>
     <StackPanel Visibility="{Binding ShowInstallSteps, Converter={StaticResource BoolToVis}}">
      <ItemsControl ItemsSource="{Binding InstallSteps}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,12"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <TextBlock Text="{Binding PathStatus}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="{Binding ShowFolder, Converter={StaticResource BoolToVis}}" AutomationProperties.LiveSetting="Polite"/>
      <Button Content="{Binding InstallAction}" Command="{Binding OpenInstallCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,0,0,10" Visibility="{Binding ShowInstallActions, Converter={StaticResource BoolToVis}}"/>
      <Expander Header="{DynamicResource Setup_Folder}" Visibility="{Binding ShowFolder, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12"><StackPanel Margin="0,8,0,0">
       <TextBox Text="{Binding ExtensionDirectory, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AutomationProperties.Name="{DynamicResource Setup_Folder}"/>
       <Button Content="{DynamicResource Setup_CopyFolder}" Command="{Binding CopyFolderCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
      </StackPanel></Expander>
     </StackPanel>
     <StackPanel Visibility="{Binding ShowProfiles, Converter={StaticResource BoolToVis}}" Margin="0,8,0,12"><Label Content="{DynamicResource Browser_Profile}" Target="{Binding ElementName=ProfilePicker}"/><ComboBox x:Name="ProfilePicker" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="DisplayName" AutomationProperties.Name="{DynamicResource Browser_Profile}"/></StackPanel>
     <Border Background="{DynamicResource PanelBg}" CornerRadius="4" Padding="14" Margin="0,4,0,0" Visibility="{Binding ConnectionReady, Converter={StaticResource BoolToVis}}">
      <StackPanel><TextBlock Text="{DynamicResource Setup_RestoreTitle}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding RestoreHint}" TextWrapping="Wrap" Margin="0,6,0,12"/>
       <TextBlock Text="{DynamicResource Setup_ChooseInBrowser}" Foreground="{DynamicResource TextSecondary}"/><TextBlock Text="{Binding RestoreChoice}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,12"/>
       <Button Content="{DynamicResource Setup_Startup}" Command="{Binding OpenStartupCommand}" HorizontalAlignment="Left"/>
       <Expander Header="{DynamicResource UI_Details}" Margin="0,8,0,0"><TextBlock Text="{DynamicResource Setup_RestoreDetails}" TextWrapping="Wrap" Margin="0,8,0,0"/></Expander>
      </StackPanel>
     </Border>
     <Button Content="{DynamicResource Setup_Check}" Command="{Binding RefreshConnectionCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" Visibility="{Binding ShowHostReady, Converter={StaticResource BoolToVis}}"/>
    </StackPanel>
   </StackPanel>
  </ScrollViewer>
 </DockPanel>
</Window>
