<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:AppSwitcher.Controls" x:Class="AppSwitcher.SettingsWindow" Title="{DynamicResource Settings_Title}" Style="{StaticResource AppWindowStyle}" Width="1180" Height="800" MinWidth="640" MinHeight="560" WindowStartupLocation="CenterScreen" SizeChanged="Workspace_SizeChanged">

 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1" Padding="20,10">
   <DockPanel>
    <StackPanel DockPanel.Dock="Right" Margin="20,0,0,0" VerticalAlignment="Center">
     <TextBlock Text="{Binding AccessLevelLabel}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
     <TextBlock Text="{Binding SessionTimeoutLabel}" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondary}" FontSize="12" Visibility="{Binding Runtime.IsSessionTimeoutActive, Converter={StaticResource BoolToVis}}"/>
    </StackPanel>
    <StackPanel><TextBlock Text="{DynamicResource Settings_Configuration}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource UI_ReadOnly}" Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsAdmin}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="184"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,1,0" Padding="12,16" Background="{DynamicResource SidebarBg}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
     <StackPanel>
      <TextBlock Text="{DynamicResource UI_SettingsSearch}" Foreground="{DynamicResource TextSecondary}" Margin="4,0,0,6"/>
      <TextBox x:Name="SettingsSearchBox" Text="{Binding SettingsSearch, UpdateSourceTrigger=PropertyChanged, Delay=150}" AutomationProperties.Name="{DynamicResource UI_SettingsSearch}" PreviewKeyDown="SettingsSearch_KeyDown" Margin="0,0,0,8"/>
      <Border Visibility="{Binding HasSettingsSearch, Converter={StaticResource BoolToVis}}" Background="{DynamicResource PanelBg}" Margin="0,0,0,10">
       <StackPanel><TextBlock Text="{DynamicResource UI_SearchResults}" Margin="8,6" Foreground="{DynamicResource TextSecondary}"/>
        <ListBox x:Name="SettingsSearchResults" ItemsSource="{Binding SearchResults}" MaxHeight="230" SelectionChanged="SearchResult_Selected" AutomationProperties.Name="{DynamicResource UI_SearchResults}">
         <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Label}" TextWrapping="Wrap"/><TextBlock Text="{Binding SectionLabel}" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
       </StackPanel>
      </Border>
      <ListBox x:Name="SectionList" SelectedValue="{Binding ActiveSection}" SelectedValuePath="Tag" AutomationProperties.Name="{DynamicResource UI_Workspace}">
       <ListBoxItem Tag="Setup" Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"><TextBlock Text="{DynamicResource UI_Setup}" TextWrapping="Wrap"/></ListBoxItem>
       <ListBoxItem Tag="Applications" Content="{DynamicResource UI_Applications}"/>
       <ListBoxItem Tag="Monitoring" Content="{DynamicResource UI_Monitoring}"/>
       <ListBoxItem Tag="Layouts" Content="{DynamicResource UI_Layouts}"/>
       <ListBoxItem Tag="Access" Content="{DynamicResource UI_Access}" Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"/>
       <ListBoxItem Tag="Audit" Content="{DynamicResource UI_Audit}" Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"/>
       <ListBoxItem Tag="System" Content="{DynamicResource UI_System}"/>
       <ListBoxItem Tag="Browsers" Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"><TextBlock Text="{DynamicResource UI_Browsers}" TextWrapping="Wrap"/></ListBoxItem>
      </ListBox>
     </StackPanel>
    </ScrollViewer>
   </Border>
   <Grid Grid.Column="1" Margin="20">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" Visibility="{Binding ActiveSection, Converter={StaticResource SectionVisibility}, ConverterParameter=Setup}">
     <StackPanel>
      <TextBlock Text="{DynamicResource UI_Setup}" FontSize="24" FontWeight="SemiBold"/>
      <TextBlock Text="{DynamicResource Setup_Intro}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" Margin="0,8,8,16"/>
      <ItemsControl ItemsSource="{Binding SetupSteps}"><ItemsControl.ItemTemplate><DataTemplate>
       <Border Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Padding="16" Margin="0,0,8,12">
        <StackPanel>
         <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
         <TextBlock Text="{Binding Status}" Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite"/>
         <TextBlock Text="{Binding Hint}" TextWrapping="Wrap" Margin="0,8,0,12"/>
         <Button Content="{DynamicResource Setup_Open}" AutomationProperties.Name="{Binding Title}" HorizontalAlignment="Left" Command="{Binding DataContext.OpenSetupStepCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
        </StackPanel>
       </Border>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </StackPanel>
    </ScrollViewer>
    <Grid Visibility="{Binding ActiveSection, Converter={StaticResource SectionVisibility}, ConverterParameter=Applications}">
     <Grid.ColumnDefinitions><ColumnDefinition x:Name="AppListColumn" Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <DockPanel x:Name="CompactAppHeader" Grid.ColumnSpan="2" Margin="0,0,0,12" Visibility="Collapsed">
      <Button x:Name="CompactAppControls" DockPanel.Dock="Right" Content="{DynamicResource UI_Actions}" Click="CompactActions_Click" Margin="8,0,0,0" Visibility="{Binding CanEditApps, Converter={StaticResource BoolToVis}}">
       <Button.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
        <MenuItem Header="{DynamicResource WindowPicker_Title}" Command="{Binding AddFromOpenWindowCommand}"/>
        <MenuItem Header="{DynamicResource Settings_AddApp}" Command="{Binding AddAppCommand}"/>
        <MenuItem Header="{DynamicResource UI_MoveUp}" Command="{Binding MoveAppCommand}" CommandParameter="-1"/>
        <MenuItem Header="{DynamicResource UI_MoveDown}" Command="{Binding MoveAppCommand}" CommandParameter="1"/>
        <Separator/><MenuItem Header="{DynamicResource Settings_DeleteApp}" Command="{Binding DeleteAppCommand}" Foreground="{DynamicResource DangerFg}"/>
       </ContextMenu></Button.ContextMenu>
      </Button>
      <ComboBox x:Name="CompactAppSelector" ItemsSource="{Binding VisibleApps}" SelectedItem="{Binding SelectedApp}" DisplayMemberPath="Name" Style="{StaticResource ModernComboBox}" AutomationProperties.Name="{DynamicResource UI_Applications}"/>
     </DockPanel>
     <DockPanel x:Name="AppListPane" Grid.Row="2" Margin="0,0,16,0">
      <TextBlock DockPanel.Dock="Top" Text="{DynamicResource UI_Applications}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
      <Button x:Name="AddAppMenuButton" DockPanel.Dock="Bottom" Content="{DynamicResource Settings_AddApp}" Click="AddAppMenu_Click" Margin="0,12,0,0" Visibility="{Binding CanEditApps, Converter={StaticResource BoolToVis}}">
       <Button.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
        <MenuItem Header="{DynamicResource WindowPicker_Title}" Command="{Binding AddFromOpenWindowCommand}"/>
        <MenuItem Header="{DynamicResource WindowPicker_Manual}" Command="{Binding AddAppCommand}"/>
       </ContextMenu></Button.ContextMenu>
      </Button>
      <UniformGrid DockPanel.Dock="Bottom" Columns="2" Margin="0,8,0,0" Visibility="{Binding CanEditApps, Converter={StaticResource BoolToVis}}">
       <Button Content="{DynamicResource UI_MoveUp}" Command="{Binding MoveAppCommand}" CommandParameter="-1" Margin="0,0,4,0" Padding="4,8"/>
       <Button Content="{DynamicResource UI_MoveDown}" Command="{Binding MoveAppCommand}" CommandParameter="1" Margin="4,0,0,0" Padding="4,8"/>
      </UniformGrid>
      <ListBox ItemsSource="{Binding VisibleApps}" SelectedItem="{Binding SelectedApp}" AllowDrop="True" AutomationProperties.Name="{DynamicResource UI_Applications}" ScrollViewer.PanningMode="VerticalOnly">
       <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextWrapping="Wrap"/></DataTemplate></ListBox.ItemTemplate>
       <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource ConsoleListBoxItem}">
        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="ListBoxItem_PreviewMouseLeftButtonDown"/><EventSetter Event="PreviewMouseMove" Handler="ListBoxItem_PreviewMouseMove"/><EventSetter Event="Drop" Handler="ListBoxItem_Drop"/>
        <Setter Property="AllowDrop" Value="True"/>
       </Style></ListBox.ItemContainerStyle>
      </ListBox>
     </DockPanel>
     <Grid Grid.Column="1" Grid.Row="2">
      <StackPanel VerticalAlignment="Center" Margin="20"><TextBlock Text="{DynamicResource UI_SelectApp}" FontSize="24" TextWrapping="Wrap"/><TextBlock Text="{DynamicResource UI_SelectAppHint}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,12,0,0"/>
       <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedApp}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
      </StackPanel>
      <controls:AppSettingsPanel x:Name="AppEditor"><controls:AppSettingsPanel.Style><Style TargetType="controls:AppSettingsPanel"><Style.Triggers><DataTrigger Binding="{Binding SelectedApp}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></controls:AppSettingsPanel.Style></controls:AppSettingsPanel>
     </Grid>
    </Grid>
    <controls:HealthPanel DataContext="{Binding Runtime}" Visibility="{Binding DataContext.ActiveSection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SectionVisibility}, ConverterParameter=Monitoring}"/>
    <controls:GlobalSettingsPanel/>
    <controls:BrowserConnectionsPanel Visibility="{Binding ActiveSection, Converter={StaticResource SectionVisibility}, ConverterParameter=Browsers}"/>
   </Grid>
  </Grid>
  <Border Grid.Row="2" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Padding="20,12">
   <DockPanel>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="20,0,0,0">
     <Button x:Name="UndoButton" Content="{DynamicResource UI_Undo}" Command="{Binding UndoCommand}" Visibility="{Binding ShowSaveAction, Converter={StaticResource BoolToVis}}" Margin="0,0,8,0"/>
     <Button x:Name="SaveButton" Content="{DynamicResource UI_Save}" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Visibility="{Binding ShowSaveAction, Converter={StaticResource BoolToVis}}" Margin="0,0,8,0"/>
     <Button Content="{DynamicResource UI_Close}" Click="CloseBtn_Click"/>
    </StackPanel>
    <TextBlock Text="{Binding SaveStatus}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
   </DockPanel>
  </Border>
 </Grid>
</Window>
