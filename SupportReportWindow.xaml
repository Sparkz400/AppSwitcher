<Window x:Class="AppSwitcher.SupportReportWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="{DynamicResource Support_Title}" Style="{StaticResource AppWindowStyle}" Width="760" Height="620" MinWidth="400" MinHeight="320" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
 <DockPanel Margin="24">
  <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Support_Redaction}" TextWrapping="Wrap" Margin="0,0,0,16"/>
  <Button DockPanel.Dock="Bottom" Content="{DynamicResource Support_Save}" Click="Save_Click" HorizontalAlignment="Right" Margin="0,16,0,0"/>
  <TextBox x:Name="ReportText" IsReadOnly="True" FontFamily="Consolas" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="{DynamicResource Support_Title}"/>
 </DockPanel>
</Window>
