<Window x:Class="AppSwitcher.PasswordDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="{DynamicResource Password_Title}" Style="{StaticResource AppWindowStyle}" Width="390" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False" PreviewKeyDown="Pin_KeyDown">
 <Window.Resources><Style x:Key="NumPadButton" TargetType="Button" BasedOn="{StaticResource ConsoleButton}"><Setter Property="FontSize" Value="22"/><Setter Property="MinHeight" Value="56"/><Setter Property="Margin" Value="4"/></Style></Window.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly"><StackPanel Margin="24">
  <TextBlock x:Name="HeadingText" Text="{DynamicResource Password_Heading}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/>
  <TextBlock Text="{DynamicResource UI_PinHelp}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" Margin="0,8,0,16"/>
  <Border Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="4" Padding="16">
   <TextBlock x:Name="PinDisplay" Height="32" FontSize="24" TextAlignment="Center" AutomationProperties.Name="{DynamicResource UI_PIN}"/>
  </Border>
  <TextBlock x:Name="ErrorText" Visibility="Collapsed" Foreground="{DynamicResource DangerFg}" Margin="0,12,0,8" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/>
  <UniformGrid Columns="3" Margin="-4,16,-4,0">
   <Button Content="1" Click="NumPad_Click" Style="{StaticResource NumPadButton}"/><Button Content="2" Click="NumPad_Click" Style="{StaticResource NumPadButton}"/><Button Content="3" Click="NumPad_Click" Style="{StaticResource NumPadButton}"/>
   <Button Content="4" Click="NumPad_Click" Style="{StaticResource NumPadButton}"/><Button Content="5" Click="NumPad_Click" Style="{StaticResource NumPadButton}"/><Button Content="6" Click="NumPad_Click" Style="{StaticResource NumPadButton}"/>
   <Button Content="7" Click="NumPad_Click" Style="{StaticResource NumPadButton}"/><Button Content="8" Click="NumPad_Click" Style="{StaticResource NumPadButton}"/><Button Content="9" Click="NumPad_Click" Style="{StaticResource NumPadButton}"/>
   <Button Content="{DynamicResource UI_Clear}" Click="Clear_Click" Style="{StaticResource NumPadButton}" FontSize="14"/><Button Content="0" Click="NumPad_Click" Style="{StaticResource NumPadButton}"/><Button Content="⌫" Click="Backspace_Click" Style="{StaticResource NumPadButton}" AutomationProperties.Name="{DynamicResource UI_Backspace}" ToolTip="{DynamicResource UI_Backspace}"/>
  </UniformGrid>
  <UniformGrid Columns="2" Margin="-4,20,-4,0">
   <Button Content="{DynamicResource Password_Cancel}" Click="Cancel_Click" IsCancel="True" Margin="4"/>
   <Button Content="{DynamicResource Password_Confirm}" Click="Confirm_Click" IsDefault="True" Style="{StaticResource PrimaryButton}" Margin="4"/>
  </UniformGrid>
 </StackPanel></ScrollViewer>
</Window>
