<Window x:Class="AppSwitcher.ConfirmationDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="{DynamicResource Confirm_Title}" Style="{StaticResource AppWindowStyle}" Width="540" SizeToContent="Height" MaxHeight="620" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock x:Name="HeadingText" Text="{DynamicResource Confirm_Title}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,16"/>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly"><StackPanel>
   <TextBlock x:Name="MessageText" FontSize="16" TextWrapping="Wrap" Margin="0,0,0,16"/>
   <TextBlock x:Name="DetailText" Text="{DynamicResource Msg_ConfirmKillWarning}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"/>
  </StackPanel></ScrollViewer>
  <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,24,0,0">
   <Button x:Name="CancelButton" Content="{DynamicResource Password_Cancel}" Click="Cancel_Click" IsCancel="True" Margin="0,0,8,0"/>
   <Button x:Name="ConfirmButton" Content="{DynamicResource Password_Confirm}" Click="Confirm_Click" Style="{StaticResource DangerButton}"/>
  </WrapPanel>
 </Grid>
</Window>
