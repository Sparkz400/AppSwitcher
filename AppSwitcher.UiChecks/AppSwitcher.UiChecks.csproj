<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../AppSwitcher.Tests/AppSwitcher.Tests.csproj"/></ItemGroup>
  <ItemGroup>
    <Page Include="../Themes/*.xaml" Exclude="../Themes/Controls.xaml" Link="Themes/%(Filename)%(Extension)"/>
    <Page Include="../Languages/*.xaml" Link="Languages/%(Filename)%(Extension)"/>
  </ItemGroup>
</Project>
