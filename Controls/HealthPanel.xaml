<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:conv="clr-namespace:AppSwitcher.Converters" x:Class="AppSwitcher.Controls.HealthPanel">
 <UserControl.Resources><conv:TimeSpanToStringConverter x:Key="TimeSpanConv"/></UserControl.Resources>
 <DockPanel>
  <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16"><TextBlock Text="{DynamicResource UI_Monitoring}" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource UI_SoftwareStatus}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
   <StackPanel>
    <Border Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Padding="16" Margin="0,0,8,12">
     <StackPanel>
      <WrapPanel><TextBlock Text="{Binding MaintenanceStatus}" TextWrapping="Wrap" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" Margin="0,10,16,8"/>
      <WrapPanel Visibility="{Binding CanAdminister, Converter={StaticResource BoolToVis}}">
       <Button Content="{DynamicResource Maintenance_Pause}" Command="{Binding PauseMaintenanceCommand}" CommandParameter="30" Margin="0,0,8,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource ConsoleButton}"><Style.Triggers><DataTrigger Binding="{Binding IsMaintenancePaused}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
       <Button Content="{DynamicResource Maintenance_Resume}" Command="{Binding ResumeMaintenanceCommand}" Visibility="{Binding IsMaintenancePaused, Converter={StaticResource BoolToVis}}"/>
      </WrapPanel>
     </WrapPanel><Expander Header="{DynamicResource UI_PauseScope}" Margin="0,8,0,4"><StackPanel Margin="0,8,0,8"><TextBlock Text="{DynamicResource Maintenance_Hint}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,10"/>
      </StackPanel></Expander></StackPanel>
    </Border>
    <CheckBox Content="{DynamicResource Monitoring_NeedsAttention}" IsChecked="{Binding ShowNeedsAttentionOnly}" Margin="0,0,0,12"/>
    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" Margin="0,16" AutomationProperties.LiveSetting="Polite"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Setter Property="Text" Value="{DynamicResource UI_NoApps}"/><Style.Triggers><DataTrigger Binding="{Binding ShowNeedsAttentionOnly}" Value="True"><Setter Property="Text" Value="{DynamicResource Monitoring_NoAttention}"/></DataTrigger><DataTrigger Binding="{Binding MonitoringApps.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    <ItemsControl ItemsSource="{Binding MonitoringApps}"><ItemsControl.ItemTemplate><DataTemplate>
     <Border Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Padding="14" Margin="0,0,8,12" CornerRadius="4">
      <StackPanel>
       <WrapPanel Margin="0,0,0,4"><TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,16,8"/>
       <WrapPanel>
        <Button Content="{DynamicResource UI_OpenApp}" Command="{Binding DataContext.LaunchAppCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="0,0,8,0"/>
        <Button Content="{DynamicResource Dashboard_AcknowledgeWatchdog}" Command="{Binding DataContext.AcknowledgeWatchdogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Visibility="{Binding RequiresWatchdogAcknowledgement, Converter={StaticResource BoolToVis}}" Foreground="{DynamicResource WarningFg}"/>
       </WrapPanel>
      </WrapPanel><TextBlock Margin="0,4,0,0" FontWeight="SemiBold"><TextBlock.Text><MultiBinding Converter="{StaticResource AppStateText}"><Binding Path="State"/><Binding Path="IsResponding"/><Binding Path="DataContext.Settings.Language" RelativeSource="{RelativeSource AncestorType=UserControl}"/></MultiBinding></TextBlock.Text></TextBlock>
       <TextBlock Text="{Binding HealthStatus}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,4,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding HealthStatus}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding HealthStatus}" Value="OK"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding HealthStatus}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
       <TextBlock Text="{Binding WatchdogStatusText}" Foreground="{DynamicResource WarningFg}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{Binding WatchdogStatusText, Converter={StaticResource StringNotEmptyToVis}}"/>
       <TextBlock Text="{DynamicResource UI_TabMetricsUnavailable}" Foreground="{DynamicResource TextMuted}" Margin="0,10,0,0" Visibility="{Binding IsWebsite, Converter={StaticResource BoolToVis}}"/><WrapPanel Margin="0,10,0,0" Visibility="{Binding IsNative, Converter={StaticResource BoolToVis}}">
        <StackPanel MinWidth="80" Margin="0,0,20,8"><TextBlock Text="{DynamicResource Label_CPU}" Foreground="{DynamicResource TextSecondary}" FontSize="12"/><TextBlock Text="{Binding CpuPercent, StringFormat={}{0:0.0}%}" FontSize="16"/></StackPanel>
        <StackPanel MinWidth="80" Margin="0,0,20,8"><TextBlock Text="{DynamicResource Label_RAM}" Foreground="{DynamicResource TextSecondary}" FontSize="12"/><TextBlock Text="{Binding MemoryMB, StringFormat={}{0:0} MB}" FontSize="16"/></StackPanel>
        </WrapPanel>
       <Expander Header="{DynamicResource UI_Details}" Margin="0,6,0,0"><WrapPanel Margin="0,8,0,0"><StackPanel MinWidth="80" Margin="0,0,20,8"><TextBlock Text="{DynamicResource Dashboard_Uptime}" Foreground="{DynamicResource TextSecondary}" FontSize="12"/><TextBlock Text="{Binding LastStartTime, Converter={StaticResource TimeSpanConv}}" FontSize="16"/></StackPanel>
        <StackPanel MinWidth="80" Margin="0,0,20,8"><TextBlock Text="{DynamicResource Dashboard_CrashesToday}" Foreground="{DynamicResource TextSecondary}" FontSize="12"/><TextBlock Text="{Binding CrashCountToday}" FontSize="16"/></StackPanel>
        <StackPanel MinWidth="80" Margin="0,0,20,8"><TextBlock Text="{DynamicResource Dashboard_TotalRestarts}" Foreground="{DynamicResource TextSecondary}" FontSize="12"/><TextBlock Text="{Binding TotalRestarts}" FontSize="16"/></StackPanel>
       </WrapPanel></Expander></StackPanel>
     </Border>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   </StackPanel>
  </ScrollViewer>
 </DockPanel>
</UserControl>
