<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:conv="clr-namespace:AppSwitcher.Converters" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="AppSwitcher.Controls.AppSettingsPanel">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InvertBoolConverter x:Key="InvertBool" />
        <Style TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
            <Setter Property="IsEnabled" Value="{Binding DataContext.CanEditApps, RelativeSource={RelativeSource AncestorType=Window}}" />
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource ModernComboBox}">
            <Setter Property="IsEnabled" Value="{Binding DataContext.CanEditApps, RelativeSource={RelativeSource AncestorType=Window}}" />
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource ConsoleCheckBox}">
            <Setter Property="IsEnabled" Value="{Binding DataContext.CanEditApps, RelativeSource={RelativeSource AncestorType=Window}}" />
        </Style>
        <Style TargetType="ToggleButton" BasedOn="{StaticResource ConsoleToggleButton}">
            <Setter Property="IsEnabled" Value="{Binding DataContext.CanEditApps, RelativeSource={RelativeSource AncestorType=Window}}" />
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource ConsoleButton}">
            <Setter Property="IsEnabled" Value="{Binding DataContext.CanEditApps, RelativeSource={RelativeSource AncestorType=Window}}" />
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <DockPanel x:Name="EditorHeading" LastChildFill="True" Margin="0,0,0,20" DockPanel.Dock="Top">
            <Button DockPanel.Dock="Right" Command="{Binding DeleteAppCommand}" Content="{DynamicResource Settings_DeleteApp}" Background="{DynamicResource DangerBg}" Foreground="{DynamicResource DangerFg}" BorderBrush="{DynamicResource DangerBorder}" BorderThickness="1" Padding="15,5" Cursor="Hand" Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6" />
                    </Style>
                </Button.Resources>
            </Button>
            <TextBlock Text="{Binding SelectedApp.Name}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" TextWrapping="Wrap" />
        </DockPanel>
        <TabControl>
            <TabItem Header="{DynamicResource UI_General}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                    <StackPanel Margin="0,0,8,0">
                        <Grid x:Name="NameTypeRow"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><StackPanel Margin="0,0,12,0"><Label Content="{DynamicResource Settings_DisplayName}" />
                        <TextBox IsEnabled="{Binding DataContext.CanEditApps, RelativeSource={RelativeSource AncestorType=Window}}" Text="{Binding SelectedApp.Name, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}" Margin="0,0,0,10" AutomationProperties.Name="{DynamicResource Settings_DisplayName}" />
                        </StackPanel><StackPanel Grid.Column="1"><Label Content="{DynamicResource Browser_TargetKind}" />
                        <ComboBox ItemsSource="{Binding TargetKindChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SelectedApp.TargetKind}" AutomationProperties.Name="{DynamicResource Browser_TargetKind}" Margin="0,0,0,10" />
                        </StackPanel></Grid><StackPanel Visibility="{Binding SelectedApp.IsWebsite, Converter={StaticResource BoolToVis}}">
                            <Label Content="{DynamicResource Browser_Url}" />
                            <TextBox Text="{Binding SelectedApp.WebsiteUrl, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource Browser_Url}" />
                            <Grid x:Name="BrowserProfileRow"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><StackPanel Margin="0,0,12,0"><Label Content="{DynamicResource Browser_Browser}" />
                            <ComboBox ItemsSource="{Binding BrowserChoices}" SelectedItem="{Binding SelectedApp.Browser}" AutomationProperties.Name="{DynamicResource Browser_Browser}" />
                            </StackPanel><StackPanel Grid.Column="1"><Label Content="{DynamicResource Browser_Profile}" /><ComboBox ItemsSource="{Binding BrowserProfiles}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedBrowserProfile}" AutomationProperties.Name="{DynamicResource Browser_Profile}" ToolTip="{Binding SelectedBrowserProfile.DisplayName}" />
                            </StackPanel></Grid><TextBlock Text="{DynamicResource Browser_NoProfiles}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,6,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding BrowserProfiles.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><WrapPanel Margin="0,8,0,8"><Button Content="{DynamicResource Browser_ActionSetup}" Command="{Binding SetupSelectedBrowserCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,4"/><Button Content="{DynamicResource Browser_RefreshProfiles}" Command="{Binding RefreshBrowserProfilesCommand}" Margin="0,0,0,4"/></WrapPanel>
                            <WrapPanel Margin="0,0,0,8">
                                <Button Content="{DynamicResource Browser_Check}" Command="{Binding CheckBrowserCommand}" Margin="0,0,8,4" />
                                <Button Content="{DynamicResource Browser_TestSwitch}" Command="{Binding TestBrowserSwitchCommand}" Margin="0,0,0,4" />
                            </WrapPanel>
                            <TextBlock Text="{Binding BrowserDiagnostic}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,12" AutomationProperties.LiveSetting="Polite" Visibility="{Binding BrowserDiagnostic, Converter={StaticResource StringNotEmptyToVis}}" />
                            <Expander Header="{DynamicResource Browser_SetupInstructions}" IsExpanded="{Binding BrowserSetupExpanded}" Margin="0,0,0,12">
                                <StackPanel><TextBlock Text="{DynamicResource Browser_SetupHint}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" Margin="0,10,0,10" />
                            <TextBlock Text="{DynamicResource Browser_SetupSteps}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" Margin="0,8,0,0" />
                            </StackPanel></Expander>
                            <Expander Header="{DynamicResource UI_ConnectionOptions}" Margin="0,8,0,4" IsExpanded="{Binding ConnectionOptionsExpanded}"><StackPanel Margin="0,8,0,8"><Label Content="{DynamicResource Browser_ProfileId}" />
                            <TextBox Text="{Binding SelectedApp.BrowserProfileId, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource Browser_ProfileId}" />
                            <Label Content="{DynamicResource Browser_Executable}" />
                            <TextBox Text="{Binding SelectedApp.BrowserExecutablePath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource Browser_Executable}" />
                            <Label Content="{DynamicResource Browser_ProfileDirectory}" />
                            <TextBox Text="{Binding SelectedApp.BrowserProfileDirectory, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource Browser_ProfileDirectory}" Margin="0,0,0,15" />
                        </StackPanel></Expander></StackPanel>
                        <StackPanel Visibility="{Binding SelectedApp.IsNative, Converter={StaticResource BoolToVis}}">
                        <Label Content="{DynamicResource Settings_ExePath}" />
                        <Border Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox IsEnabled="{Binding DataContext.CanEditApps, RelativeSource={RelativeSource AncestorType=Window}}" Grid.Column="0" Text="{Binding SelectedApp.Path, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}" Background="Transparent" BorderThickness="0" Padding="8,5" Foreground="{DynamicResource TextPrimary}" CaretBrush="{DynamicResource TextPrimary}" IsReadOnly="{Binding IsAdmin, Converter={StaticResource InvertBool}}" AutomationProperties.Name="{DynamicResource Settings_ExePath}" />
                                <Button Grid.Column="1" Command="{Binding BrowseExeCommand}" Style="{DynamicResource IconBtnStyle}" BorderThickness="0" Width="38" Margin="0" ToolTip="{DynamicResource UI_Browse}" Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="{DynamicResource UI_Browse}">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M19,20H4C2.89,20 2,19.1 2,18V6C2,4.89 2.89,4 4,4H10L12,6H19A2,2 0 0,1 21,8H21L4,8V18L6.14,10H23.21L20.93,18.5C20.7,19.37 19.92,20 19,20Z" Stretch="Uniform" Width="16" Height="16" />
                                </Button>
                            </Grid>
                        </Border>
                        <Expander Header="{DynamicResource Settings_WorkDir}" Margin="0,8,0,4" IsExpanded="{Binding WorkingFolderExpanded}"><StackPanel Margin="0,8,0,8"><Label Content="{DynamicResource Settings_WorkDir}" />
                        <Border Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox IsEnabled="{Binding DataContext.CanEditApps, RelativeSource={RelativeSource AncestorType=Window}}" Grid.Column="0" Text="{Binding SelectedApp.WorkingDirectory, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}" Background="Transparent" BorderThickness="0" Padding="8,5" Foreground="{DynamicResource TextPrimary}" CaretBrush="{DynamicResource TextPrimary}" AutomationProperties.Name="{DynamicResource Settings_WorkDir}" />
                                <Button Grid.Column="1" Command="{Binding BrowseWorkingDirectoryCommand}" Style="{DynamicResource IconBtnStyle}" BorderThickness="0" Width="38" Margin="0" ToolTip="{DynamicResource UI_Browse}" AutomationProperties.Name="{DynamicResource UI_Browse}">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M19,20H4C2.89,20 2,19.1 2,18V6C2,4.89 2.89,4 4,4H10L12,6H19A2,2 0 0,1 21,8H21L4,8V18L6.14,10H23.21L20.93,18.5C20.7,19.37 19.92,20 19,20Z" Stretch="Uniform" Width="16" Height="16" />
                                </Button>
                            </Grid>
                        </Border>
                        <TextBlock Text="{DynamicResource Settings_WorkDirHint}" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,15" TextWrapping="Wrap" />
                        </StackPanel></Expander><Expander Header="{DynamicResource UI_LegacyWebsite}" Margin="0,8,0,4"><StackPanel><Button Content="{DynamicResource Browser_Convert}" Command="{Binding ConvertToWebsiteCommand}" Visibility="{Binding SelectedApp.IsNative, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Left" Margin="0,0,0,10" />
                        </StackPanel></Expander></StackPanel>
                        <Label Content="{DynamicResource Settings_Group}" />
                        <ComboBox IsEnabled="{Binding DataContext.CanEditApps, RelativeSource={RelativeSource AncestorType=Window}}" SelectedValue="{Binding SelectedApp.Group, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Key" ItemsSource="{Binding GroupChoices}" Style="{DynamicResource ModernComboBox}" MaxWidth="200" HorizontalAlignment="Left" Margin="0,0,0,5" AutomationProperties.Name="{DynamicResource Settings_Group}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CurrentDisplayName}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <CheckBox IsEnabled="{Binding DataContext.CanEditApps, RelativeSource={RelativeSource AncestorType=Window}}" IsChecked="{Binding SelectedApp.IsPinned}" Margin="0,10">
                            <TextBlock Text="{DynamicResource Settings_PinToTop}" Foreground="{DynamicResource TextPrimary}" FontSize="14" TextWrapping="Wrap" />
                        </CheckBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{DynamicResource UI_Startup}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                    <StackPanel Margin="0,0,8,0">
                        <CheckBox IsEnabled="{Binding DataContext.CanEditApps, RelativeSource={RelativeSource AncestorType=Window}}" IsChecked="{Binding SelectedApp.AutoLaunch}" Margin="0,5">
                            <TextBlock Text="{DynamicResource Settings_AutoLaunch}" Foreground="{DynamicResource TextPrimary}" FontSize="14" TextWrapping="Wrap" />
                        </CheckBox>
                        <StackPanel Margin="0,0,8,0" Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}">
                            <Expander Header="{DynamicResource UI_DailySchedules}" Margin="0,8,0,4" IsExpanded="{Binding SchedulesExpanded}"><StackPanel Margin="0,8,0,8"><TextBlock Text="{DynamicResource Settings_ScheduleHint}" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,10" TextWrapping="Wrap" />
                            <Grid Margin="0,5,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Label Content="{DynamicResource Settings_ScheduleTime}" VerticalAlignment="Center" />
                                <TextBox IsEnabled="{Binding DataContext.CanEditApps, RelativeSource={RelativeSource AncestorType=Window}}" Grid.Column="1" Text="{Binding SelectedApp.ScheduleTime, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}" Width="100" HorizontalAlignment="Stretch" AutomationProperties.Name="{DynamicResource Settings_ScheduleTime}" />
                            </Grid>
                            <Grid Margin="0,5,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Label Content="{DynamicResource Settings_ScheduleRestartTime}" VerticalAlignment="Center" />
                                <TextBox IsEnabled="{Binding DataContext.CanEditApps, RelativeSource={RelativeSource AncestorType=Window}}" Grid.Column="1" Text="{Binding SelectedApp.ScheduleRestartTime, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}" Width="100" HorizontalAlignment="Stretch" AutomationProperties.Name="{DynamicResource Settings_ScheduleRestartTime}" />
                            </Grid>
                            <Grid Margin="0,5,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Label Content="{DynamicResource Settings_ScheduleShutdownTime}" VerticalAlignment="Center" />
                                <TextBox IsEnabled="{Binding DataContext.CanEditApps, RelativeSource={RelativeSource AncestorType=Window}}" Grid.Column="1" Text="{Binding SelectedApp.ScheduleShutdownTime, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}" Width="100" HorizontalAlignment="Stretch" AutomationProperties.Name="{DynamicResource Settings_ScheduleShutdownTime}" />
                            </Grid>
                            </StackPanel></Expander><Expander Header="{DynamicResource UI_StartupOrder}" Margin="0,8,0,4" IsExpanded="{Binding StartupOptionsExpanded}"><StackPanel Margin="0,8,0,8"><Label Content="{DynamicResource Readiness_Title}" />
                            <ComboBox ItemsSource="{Binding ReadinessChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SelectedApp.Readiness}" AutomationProperties.Name="{DynamicResource Readiness_Title}" />
                            <Label Content="{DynamicResource Readiness_Seconds}" />
                            <TextBox Text="{Binding SelectedApp.ReadinessTimeoutSeconds, ValidatesOnExceptions=True, NotifyOnValidationError=True}" AutomationProperties.Name="{DynamicResource Readiness_Seconds}" />
                            <TextBlock Text="{DynamicResource Readiness_Hint}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,14" />
                            <Label Content="{DynamicResource Settings_Dependencies}" FontWeight="SemiBold" />
                            <Grid Margin="0,5,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Label Content="{DynamicResource Settings_DependsOn}" VerticalAlignment="Center" />
                                <ComboBox IsEnabled="{Binding DataContext.CanEditApps, RelativeSource={RelativeSource AncestorType=Window}}" Grid.Column="1" IsEditable="True" Text="{Binding SelectedApp.DependsOn, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding Apps}" DisplayMemberPath="Name" Style="{DynamicResource ModernComboBox}" MaxWidth="200" HorizontalAlignment="Left" AutomationProperties.Name="{DynamicResource Settings_DependsOn}" />
                            </Grid>
                            <TextBlock Text="{DynamicResource Settings_DependsOnHint}" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,10" TextWrapping="Wrap" />
                            <Grid Margin="0,5,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Label Content="{DynamicResource Settings_LaunchDelay}" VerticalAlignment="Center" />
                                <TextBox IsEnabled="{Binding DataContext.CanEditApps, RelativeSource={RelativeSource AncestorType=Window}}" Grid.Column="1" Text="{Binding SelectedApp.LaunchDelay, ValidatesOnExceptions=True, NotifyOnValidationError=True}" Width="80" HorizontalAlignment="Stretch" AutomationProperties.Name="{DynamicResource Settings_LaunchDelay}" />
                            </Grid>
                            <TextBlock Text="{DynamicResource Settings_LaunchDelayHint}" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,15" TextWrapping="Wrap" />
                        </StackPanel></Expander></StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{DynamicResource UI_Recovery}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                    <StackPanel Margin="0,0,8,0">
                        <CheckBox IsEnabled="{Binding DataContext.CanEditApps, RelativeSource={RelativeSource AncestorType=Window}}" IsChecked="{Binding SelectedApp.WatchdogEnabled}" Margin="0,10">
                            <TextBlock Text="{DynamicResource Settings_Watchdog}" Foreground="{DynamicResource TextPrimary}" FontSize="14" TextWrapping="Wrap" />
                        </CheckBox>
                        <Grid Margin="25,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Label Content="{DynamicResource Settings_MaxRestarts}" VerticalAlignment="Center" />
                            <TextBox IsEnabled="{Binding DataContext.CanEditApps, RelativeSource={RelativeSource AncestorType=Window}}" Grid.Column="1" Text="{Binding SelectedApp.MaxRestarts, ValidatesOnExceptions=True, NotifyOnValidationError=True}" Width="60" HorizontalAlignment="Stretch" AutomationProperties.Name="{DynamicResource Settings_MaxRestarts}" />
                        </Grid>
                        <CheckBox IsEnabled="{Binding DataContext.CanEditApps, RelativeSource={RelativeSource AncestorType=Window}}" IsChecked="{Binding SelectedApp.RequireConfirmation}" Margin="0,5">
                            <TextBlock Text="{DynamicResource Settings_RequireConfirmation}" Foreground="{DynamicResource TextPrimary}" FontSize="14" TextWrapping="Wrap" />
                        </CheckBox>
                        <StackPanel Margin="0,0,8,0" Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}">
                            <Expander Header="{DynamicResource UI_HealthChecks}" Margin="0,8,0,4" IsExpanded="{Binding HealthChecksExpanded}"><StackPanel Margin="0,8,0,8">
                            <Grid Margin="0,5,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Label Content="{DynamicResource Settings_HealthCheckUrl}" VerticalAlignment="Center" />
                                <TextBox IsEnabled="{Binding DataContext.CanEditApps, RelativeSource={RelativeSource AncestorType=Window}}" Grid.Column="1" Text="{Binding SelectedApp.HealthCheckUrl, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}" HorizontalAlignment="Stretch" AutomationProperties.Name="{DynamicResource Settings_HealthCheckUrl}" />
                            </Grid>
                            <TextBlock Text="{DynamicResource Settings_HealthCheckHint}" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,15" TextWrapping="Wrap" />
                            <StackPanel Visibility="{Binding SelectedApp.IsNative, Converter={StaticResource BoolToVis}}"><Label Content="{DynamicResource Settings_ResourceMonitoring}" FontWeight="SemiBold" />
                            <Grid Margin="0,5,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Label Content="{DynamicResource Settings_MemoryThreshold}" VerticalAlignment="Center" />
                                <TextBox IsEnabled="{Binding DataContext.CanEditApps, RelativeSource={RelativeSource AncestorType=Window}}" Grid.Column="1" Text="{Binding SelectedApp.MemoryThresholdMB, ValidatesOnExceptions=True, NotifyOnValidationError=True}" Width="80" HorizontalAlignment="Stretch" AutomationProperties.Name="{DynamicResource Settings_MemoryThreshold}" />
                            </Grid>
                            <TextBlock Text="{DynamicResource Settings_MemoryThresholdHint}" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,15" TextWrapping="Wrap" />
                        </StackPanel></StackPanel></Expander></StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{DynamicResource UI_WindowPlacement}" Visibility="{Binding SelectedApp.IsNative, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                    <StackPanel Margin="0,0,8,0">
                        <Label Content="{DynamicResource Settings_WinTitle}" />
                        <TextBox IsEnabled="{Binding DataContext.CanEditApps, RelativeSource={RelativeSource AncestorType=Window}}" Text="{Binding SelectedApp.WinPattern, ValidatesOnExceptions=True, NotifyOnValidationError=True}" Margin="0,0,0,5" AutomationProperties.Name="{DynamicResource Settings_WinTitle}" />
                        <TextBlock Text="{DynamicResource Settings_WinTitleHint}" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,15" TextWrapping="Wrap" />
                        <StackPanel Margin="0,0,8,0" Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}">
                            <Label Content="{DynamicResource Settings_WindowPolicy}" FontWeight="SemiBold" />
                            <Grid Margin="0,5,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Label Content="{DynamicResource Settings_PlacementMode}" VerticalAlignment="Center" />
                                <ComboBox IsEnabled="{Binding DataContext.CanEditApps, RelativeSource={RelativeSource AncestorType=Window}}" Grid.Column="1" SelectedValue="{Binding SelectedApp.PlacementMode}" SelectedValuePath="Value" DisplayMemberPath="Label" ItemsSource="{Binding WindowPlacementChoices}" Style="{DynamicResource ModernComboBox}" MaxWidth="200" HorizontalAlignment="Left" AutomationProperties.Name="{DynamicResource Settings_PlacementMode}" />
                            </Grid>
                            <Grid Margin="0,5,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Label Content="{DynamicResource Settings_ForcedMonitor}" VerticalAlignment="Center" />
                                <ComboBox IsEnabled="{Binding DataContext.CanEditApps, RelativeSource={RelativeSource AncestorType=Window}}" Grid.Column="1" SelectedValue="{Binding AppMonitorSelection}" SelectedValuePath="Value" ItemsSource="{Binding WindowPolicyMonitorChoices}" Style="{DynamicResource ModernComboBox}" MaxWidth="240" HorizontalAlignment="Left" AutomationProperties.Name="{DynamicResource Settings_ForcedMonitor}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" MaxWidth="200" TextWrapping="Wrap"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                            </Grid>
                            <CheckBox IsEnabled="{Binding DataContext.CanEditApps, RelativeSource={RelativeSource AncestorType=Window}}" IsChecked="{Binding SelectedApp.AlwaysOnTop}" Margin="0,5">
                                <TextBlock Text="{DynamicResource Settings_AlwaysOnTop}" Foreground="{DynamicResource TextPrimary}" FontSize="14" TextWrapping="Wrap" />
                            </CheckBox>
                            <CheckBox IsEnabled="{Binding DataContext.CanEditApps, RelativeSource={RelativeSource AncestorType=Window}}" IsChecked="{Binding SelectedApp.ReapplyPlacementContinuously}" Margin="0,10">
                                <TextBlock Text="{DynamicResource Settings_ReapplyPlacementContinuously}" Foreground="{DynamicResource TextPrimary}" FontSize="14" TextWrapping="Wrap" />
                            </CheckBox>
                            <TextBlock Text="{DynamicResource Settings_WindowPolicyHint}" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,15" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{DynamicResource UI_Advanced}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                    <StackPanel Margin="0,0,8,0">
                        <StackPanel Visibility="{Binding SelectedApp.IsNative, Converter={StaticResource BoolToVis}}"><Label Content="{DynamicResource Settings_StartArgs}" />
                        <TextBox IsEnabled="{Binding DataContext.CanEditApps, RelativeSource={RelativeSource AncestorType=Window}}" Text="{Binding SelectedApp.Args, ValidatesOnExceptions=True, NotifyOnValidationError=True}" Margin="0,0,0,10" AutomationProperties.Name="{DynamicResource Settings_StartArgs}" />
                        </StackPanel><Label Content="{DynamicResource Settings_DisplayMode}" />
                        <ComboBox IsEnabled="{Binding DataContext.CanEditApps, RelativeSource={RelativeSource AncestorType=Window}}" SelectedValue="{Binding SelectedApp.Mode}" SelectedValuePath="Value" DisplayMemberPath="Label" ItemsSource="{Binding DisplayModeChoices}" Style="{DynamicResource ModernComboBox}" MaxWidth="200" HorizontalAlignment="Left" Margin="0,0,0,10" AutomationProperties.Name="{DynamicResource Settings_DisplayMode}">
                </ComboBox>
                        <Label Content="{DynamicResource Settings_CustomIcon}" />
                        <Border Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox IsEnabled="{Binding DataContext.CanEditApps, RelativeSource={RelativeSource AncestorType=Window}}" Grid.Column="0" Text="{Binding SelectedApp.CustomIconPath, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}" Background="Transparent" BorderThickness="0" Padding="8,5" Foreground="{DynamicResource TextPrimary}" CaretBrush="{DynamicResource TextPrimary}" AutomationProperties.Name="{DynamicResource Settings_CustomIcon}" />
                                <Button Grid.Column="1" Command="{Binding BrowseIconCommand}" Style="{DynamicResource IconBtnStyle}" BorderThickness="0" Width="38" Margin="0" ToolTip="{DynamicResource UI_Browse}" AutomationProperties.Name="{DynamicResource UI_Browse}">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M8.5,13.5L11,16.5L14.5,12L19,18H5M21,19V5C21,3.89 20.1,3 19,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19Z" Stretch="Uniform" Width="16" Height="16" />
                                </Button>
                            </Grid>
                        </Border>
                        <Label Content="{DynamicResource Settings_ButtonColor}" />
                        <ToggleButton IsEnabled="{Binding DataContext.CanEditApps, RelativeSource={RelativeSource AncestorType=Window}}" Template="{DynamicResource ColorPickerTemplate}" Content="{Binding SelectedApp.BgColor}" Width="150" HorizontalAlignment="Left" Height="44" Margin="0,0,0,15" AutomationProperties.Name="{DynamicResource Settings_ButtonColor}" />
                        <StackPanel Margin="0,0,8,0" Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}">
                            <Label Content="{DynamicResource Settings_LifecycleHooks}" FontWeight="SemiBold" />
                            <Expander Header="{DynamicResource UI_LifecycleScripts}" Margin="0,8,0,4" IsExpanded="{Binding LifecycleScriptsExpanded}"><StackPanel Margin="0,8,0,8"><TextBlock Text="{DynamicResource Settings_HookHint}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8" /><Label Content="{DynamicResource Settings_PreLaunchHook}" FontWeight="SemiBold" Margin="0,5,0,0" />
                            <Grid Margin="0,5,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition />
