<UserControl x:Class="AppSwitcher.Controls.LauncherVisual" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:conv="clr-namespace:AppSwitcher.Converters" Focusable="False" IsHitTestVisible="False" Tag="{DynamicResource HighContrastEnabled}">
 <UserControl.Resources>
  <conv:ShapeToGeometryConverter x:Key="ShapeConv"/><conv:IconStyleToVisibilityConverter x:Key="IconStyleVis"/><BooleanToVisibilityConverter x:Key="BoolToVis"/>
  <Style x:Key="ForegroundFill" TargetType="Shape">
   <Setter Property="Fill" Value="{Binding FgColor}"/>
   <Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"><Setter Property="Fill" Value="{DynamicResource TextPrimary}"/></DataTrigger></Style.Triggers>
  </Style>
  <Style x:Key="ForegroundStroke" TargetType="Shape">
   <Setter Property="Stroke" Value="{Binding FgColor}"/>
   <Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"><Setter Property="Stroke" Value="{DynamicResource TextPrimary}"/></DataTrigger></Style.Triggers>
  </Style>
 </UserControl.Resources>
    <Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="{Binding ButtonSize}" Height="{Binding ButtonSize}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" MinWidth="44" MinHeight="44">

            <Path x:Name="LauncherSurface" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="None">
                <Path.Style><Style TargetType="Path"><Setter Property="Fill" Value="{Binding BgColor}"/><Setter Property="StrokeThickness" Value="0"/>
                 <Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"><Setter Property="Fill" Value="{DynamicResource WindowBg}"/><Setter Property="Stroke" Value="{DynamicResource TextPrimary}"/><Setter Property="StrokeThickness" Value="2"/></DataTrigger></Style.Triggers>
                </Style></Path.Style>
                <Path.Data>
                    <MultiBinding Converter="{StaticResource ShapeConv}">
                        <Binding Path="Shape" />
                        <Binding Path="ButtonSize" />
                    </MultiBinding>
                </Path.Data>
            </Path>


            <Path x:Name="GlowPath" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="None">
                <Path.Style><Style TargetType="Path"><Setter Property="Visibility" Value="{Binding GlowEnabled, Converter={StaticResource BoolToVis}}"/>
                 <Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                </Style></Path.Style>
                <Path.Data>
                    <MultiBinding Converter="{StaticResource ShapeConv}">
                        <Binding Path="Shape" />
                        <Binding Path="ButtonSize" />
                    </MultiBinding>
                </Path.Data>
                <Path.Effect>
                    <DropShadowEffect Color="{Binding BgColor}" BlurRadius="20" Opacity="0.7" ShadowDepth="0" />
                </Path.Effect>
            </Path>


            <StackPanel x:Name="IconHamburger" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Visibility="{Binding IconStyle, Converter={StaticResource IconStyleVis}, ConverterParameter=Hamburger}">
                <Rectangle Width="24" Height="3" Style="{StaticResource ForegroundFill}" Margin="0,2" RadiusX="1.5" RadiusY="1.5" />
                <Rectangle Width="24" Height="3" Style="{StaticResource ForegroundFill}" Margin="0,2" RadiusX="1.5" RadiusY="1.5" />
                <Rectangle Width="24" Height="3" Style="{StaticResource ForegroundFill}" Margin="0,2" RadiusX="1.5" RadiusY="1.5" />
            </StackPanel>


            <Grid x:Name="IconDots" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Visibility="{Binding IconStyle, Converter={StaticResource IconStyleVis}, ConverterParameter=Dots}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse Grid.Row="0" Grid.Column="0" Width="5" Height="5" Style="{StaticResource ForegroundFill}" Margin="2" />
                <Ellipse Grid.Row="0" Grid.Column="1" Width="5" Height="5" Style="{StaticResource ForegroundFill}" Margin="2" />
                <Ellipse Grid.Row="0" Grid.Column="2" Width="5" Height="5" Style="{StaticResource ForegroundFill}" Margin="2" />
                <Ellipse Grid.Row="1" Grid.Column="0" Width="5" Height="5" Style="{StaticResource ForegroundFill}" Margin="2" />
                <Ellipse Grid.Row="1" Grid.Column="1" Width="5" Height="5" Style="{StaticResource ForegroundFill}" Margin="2" />
                <Ellipse Grid.Row="1" Grid.Column="2" Width="5" Height="5" Style="{StaticResource ForegroundFill}" Margin="2" />
                <Ellipse Grid.Row="2" Grid.Column="0" Width="5" Height="5" Style="{StaticResource ForegroundFill}" Margin="2" />
                <Ellipse Grid.Row="2" Grid.Column="1" Width="5" Height="5" Style="{StaticResource ForegroundFill}" Margin="2" />
                <Ellipse Grid.Row="2" Grid.Column="2" Width="5" Height="5" Style="{StaticResource ForegroundFill}" Margin="2" />
            </Grid>


            <Path x:Name="IconArrow" Data="M 4,8 L 14,18 L 24,8" Style="{StaticResource ForegroundStroke}" StrokeThickness="3" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Width="28" Height="26" Stretch="Uniform" Visibility="{Binding IconStyle, Converter={StaticResource IconStyleVis}, ConverterParameter=Arrow}" />


            <Ellipse x:Name="IconRing" Width="24" Height="24" Style="{StaticResource ForegroundStroke}" StrokeThickness="3" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="{Binding IconStyle, Converter={StaticResource IconStyleVis}, ConverterParameter=Ring}" />


            <Canvas x:Name="IconPower" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="{Binding IconStyle, Converter={StaticResource IconStyleVis}, ConverterParameter=Power}">
                <Path Data="M 13,2 L 13,12" Style="{StaticResource ForegroundStroke}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Path Data="M 7,5 A 9,9 0 1 0 19,5" Style="{StaticResource ForegroundStroke}" StrokeThickness="2.5" Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Canvas>
        </Grid>
</UserControl>
