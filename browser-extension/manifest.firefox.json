{
  "manifest_version": 3,
  "name": "AppSwitcher Browser Bridge",
  "version": "1.1.0",
  "description": "Restore and activate the website tabs managed by AppSwitcher.",
  "permissions": ["tabs", "storage", "nativeMessaging", "tabGroups", "sessions", "alarms"],
  "background": { "scripts": ["core.js", "background.js"] },
  "action": { "default_popup": "profile.html", "default_title": "AppSwitcher connection" },
  "browser_specific_settings": { "gecko": { "id": "browser@appswitcher.local", "strict_min_version": "142.0", "data_collection_permissions": { "required": ["none"] } } },
  "incognito": "not_allowed"
}
