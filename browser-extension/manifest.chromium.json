{
  "manifest_version": 3,
  "name": "AppSwitcher Browser Bridge",
  "version": "1.1.0",
  "key": "",
  "description": "Restore and activate the website tabs managed by AppSwitcher.",
  "minimum_chrome_version": "120",
  "permissions": ["tabs", "storage", "nativeMessaging", "tabGroups", "alarms"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "profile.html", "default_title": "AppSwitcher connection" },
  "incognito": "not_allowed"
}
