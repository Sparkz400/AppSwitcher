<Window x:Class="AppSwitcher.ConfigurationRecoveryWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="{DynamicResource Recovery_Title}" Style="{StaticResource AppWindowStyle}" Width="680" Height="600" MinWidth="540" MinHeight="440"
 WindowStartupLocation="CenterScreen">
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly"><StackPanel>
  <StackPanel Margin="0,0,0,16">
   <TextBlock Text="{DynamicResource Recovery_Title}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/>
   <TextBlock Text="{DynamicResource Recovery_Explanation}" TextWrapping="Wrap" Margin="0,8,0,0"/>
   <Expander Header="{DynamicResource UI_Details}" Margin="0,8,0,0"><TextBlock x:Name="FailureText" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource TextSecondary}"/></Expander>
  </StackPanel>
  <TextBlock Text="{DynamicResource Recovery_Backups}" FontWeight="SemiBold" Margin="0,0,0,8"/>
  <ListBox x:Name="BackupList" MinHeight="80" MaxHeight="240" AutomationProperties.Name="{DynamicResource Recovery_Backups}" SelectionChanged="Selection_Changed">
   <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8">
    <TextBlock Text="{Binding Timestamp, StringFormat={}{0:yyyy-MM-dd HH:mm}}" FontWeight="SemiBold"/>
    <TextBlock Text="{Binding FileName}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"/>
   </StackPanel></DataTemplate></ListBox.ItemTemplate>
  </ListBox>
  <TextBlock x:Name="StatusText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Margin="0,12,0,0"/>
  </StackPanel></ScrollViewer>
  <WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="0,16,0,0">
   <Button Content="{DynamicResource Recovery_OpenFolder}" Click="OpenFolder_Click" Margin="0,0,8,8"/>
   <Button x:Name="RestoreButton" Content="{DynamicResource Recovery_Review}" Click="Restore_Click" IsEnabled="False" Margin="0,0,8,8"/>
   <Button x:Name="CloseButton" Content="{DynamicResource UI_Close}" Click="Close_Click" IsCancel="True" Margin="0,0,0,8"/>
  </WrapPanel>
 </Grid>
</Window>
